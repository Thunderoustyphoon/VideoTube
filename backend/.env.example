# Database
MONGODB_URI=create your mongodb atlas database connection string here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_can_be_any_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_can_be_any_random_string
REFRESH_TOKEN_EXPIRY=7d

# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Multer Configuration (temporary file uploads)
TEMP_FILE_PATH=public/temp
